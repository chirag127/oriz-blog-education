---
/**
 * /  — "The Margin" course front matter (SYLLABUS / OUTLINE archetype).
 *
 * The left column (BaseLayout Sidebar → SyllabusOutline) is the persistent
 * course navigation. This reading pane is the syllabus itself:
 *   1. Course header — code, term, thesis (the argument, not a big number).
 *   2. Units — numbered, each a series, with its indented lessons.
 *   3. Recent additions — the running change-log of the outline.
 *
 * No card grid. Everything is an indented outline row, like notes.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  readingTimeFor,
  slugifyTag,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const recent = allPosts.slice(0, 6)

const seriesAll = await getSeriesWithCounts()
type Unit = {
  n: string
  name: string
  slug: string
  lessons: { title: string; slug: string; rt: string; date: Date }[]
}
const units: Unit[] = []
let idx = 0
for (const { series } of seriesAll) {
  idx += 1
  const parts = await getPostsInSeries(series)
  units.push({
    n: String(idx).padStart(2, '0'),
    name: series,
    slug: slugifyTag(series),
    lessons: parts.map((p) => ({
      title: p.data.title,
      slug: p.id,
      rt: p.data.readingTime ?? readingTimeFor(p),
      date: p.data.pubDate,
    })),
  })
}

const cats = await getCategoriesWithCounts()
const lessonCount = units.reduce((n, u) => n + u.lessons.length, 0)
const lastUpdated = (allPosts[0]?.data.pubDate ?? new Date()).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout title="The Margin — a self-taught learning course" description={SITE_CONFIG.description} jsonLd={jsonLd}>
  <article class="syllabus-page">
    {/* ── Course header — the front matter of a syllabus ─────────────── */}
    <header class="course-head">
      <p class="course-meta mono">
        <span class="cm-code">EDU · THE MARGIN</span>
        <span aria-hidden="true">·</span>
        <span>{units.length} units</span>
        <span aria-hidden="true">·</span>
        <span>{lessonCount + allPosts.length} notes</span>
        <span aria-hidden="true">·</span>
        <span>updated {lastUpdated}</span>
      </p>
      <h1 class="course-thesis">
        Learning is a <span class="hl">skill<span class="hl-sweep" aria-hidden="true"></span></span> —
        and this is the outline for getting better at it.
      </h1>
      <p class="course-abstract">
        A self-taught course, kept as working notes: how to study so it sticks, how to learn
        to code without drowning, and where the good free material actually is. Read it top to
        bottom, or jump to any unit in the outline on the left. Revised as I find out I was wrong.
      </p>
    </header>

    <hr class="rule-heavy" />

    {/* ── Units — numbered, indented outline ─────────────────────────── */}
    <section class="units" aria-labelledby="units-h">
      <h2 id="units-h" class="section-h mono">Units</h2>
      <ol class="unit-list">
        {units.map((u) => (
          <li class="unit">
            <a class="unit-head" href={`/series/${u.slug}/`}>
              <span class="unit-n mono">Unit {u.n}</span>
              <span class="unit-name">{u.name}</span>
              <span class="unit-count mono">{u.lessons.length} lessons</span>
            </a>
            <ol class="lesson-list">
              {u.lessons.map((l, i) => (
                <li class="lesson">
                  <a class="lesson-link" href={`/blog/${l.slug}/`}>
                    <span class="lesson-n mono" aria-hidden="true">{u.n}.{String(i + 1).padStart(2, '0')}</span>
                    <span class="lesson-t">{l.title}</span>
                    <span class="lesson-rt mono">{l.rt}</span>
                  </a>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
    </section>

    <hr class="hairline" />

    {/* ── Recent additions — the outline's change log ────────────────── */}
    <section class="recent" aria-labelledby="recent-h">
      <h2 id="recent-h" class="section-h mono">Recent additions</h2>
      <ol class="log-list">
        {recent.map((p) => (
          <li class="log-row">
            <a class="log-link" href={`/blog/${p.id}/`}>
              <time class="log-date mono" datetime={p.data.pubDate.toISOString()}>
                {p.data.pubDate.toISOString().slice(0, 10)}
              </time>
              <span class="log-t">{p.data.title}</span>
              <span class="log-rt mono">{p.data.readingTime ?? readingTimeFor(p)}</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="all-link"><a href="/archive/">Full change log — all {allPosts.length} notes →</a></p>
    </section>

    {cats.length > 0 && (
      <>
        <hr class="hairline" />
        <section class="topics" aria-labelledby="topics-h">
          <h2 id="topics-h" class="section-h mono">Cross-references</h2>
          <p class="topic-row">
            {cats.map((c, i) => (
              <>
                {i > 0 && <span class="topic-dot" aria-hidden="true">·</span>}
                <a href={`/categories/${slugifyTag(c.category)}/`} class="topic-link">
                  {c.category}<span class="topic-count mono"> {c.count}</span>
                </a>
              </>
            ))}
          </p>
        </section>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .mono { font-family: var(--font-mono); }
  .syllabus-page { padding-block: clamp(1.5rem, 4vw, 2.5rem) 3rem; max-width: 62ch; }

  /* ── Course header ─────────────────────────────────────────────────── */
  .course-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 1.25rem;
  }
  .cm-code { color: var(--accent); font-weight: 700; }
  .course-thesis {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 3rem);
    font-weight: 600;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 60;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--ink);
    margin: 0;
  }
  .hl { position: relative; white-space: nowrap; z-index: 0; }
  .hl-sweep {
    position: absolute;
    left: -0.06em;
    right: -0.08em;
    bottom: 0.08em;
    height: 0.5em;
    background: var(--highlighter-wash);
    transform: rotate(-1.6deg);
    transform-origin: left center;
    border-radius: 2px 5px 3px 6px;
    z-index: -1;
    animation: sweep var(--dur-slow, 420ms) var(--ease-out, ease) 180ms both;
  }
  @keyframes sweep {
    from { transform: rotate(-1.6deg) scaleX(0); }
    to { transform: rotate(-1.6deg) scaleX(1); }
  }
  .course-abstract {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.6;
    color: var(--ink-mute);
    margin: 1.25rem 0 0;
  }

  .rule-heavy { height: 2px; background: var(--rule-strong); border: 0; margin: 2rem 0; }
  .hairline { height: 1px; background: var(--rule); border: 0; margin: 2rem 0; }

  .section-h {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
    font-weight: 500;
    margin: 0 0 1.25rem;
  }

  /* ── Units — the indented outline ──────────────────────────────────── */
  .unit-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.75rem; }
  .unit-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    text-decoration: none;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .unit-n { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--marker); white-space: nowrap; }
  .unit-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    line-height: 1.2;
  }
  .unit-head:hover .unit-name { color: var(--accent); }
  .unit-count { font-size: 10px; color: var(--rule-strong); white-space: nowrap; }

  .lesson-list { list-style: none; margin: 0.6rem 0 0; padding-left: clamp(1rem, 4vw, 2.25rem); }
  .lesson-link {
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    gap: 0.6rem;
    align-items: baseline;
    padding: 0.35rem 0;
    text-decoration: none;
    color: var(--ink);
    border-left: 2px solid transparent;
    padding-left: 0.6rem;
    margin-left: -0.6rem;
    transition: border-color var(--dur-fast, 120ms) ease;
  }
  .lesson-link:hover { border-left-color: var(--highlighter); }
  .lesson-n { font-size: 11px; color: var(--rule-strong); }
  .lesson-t {
    font-size: 15px;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }
  .lesson-link:hover .lesson-t { color: var(--accent); text-decoration-color: var(--highlighter-wash); }
  .lesson-rt { font-size: 10px; color: var(--ink-mute); white-space: nowrap; }

  /* ── Recent additions ──────────────────────────────────────────────── */
  .log-list { list-style: none; margin: 0; padding: 0; }
  .log-row { border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent); }
  .log-row:last-child { border-bottom: 0; }
  .log-link {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.6rem 0;
    text-decoration: none;
    color: var(--ink);
  }
  .log-date { font-size: 12px; color: var(--ink-mute); position: relative; padding-left: 0.75rem; }
  .log-date::before { content: ''; position: absolute; left: 0; top: 0.15em; width: 3px; height: 0.7em; background: var(--marker); }
  .log-t { font-family: var(--font-display); font-size: 15px; font-weight: 500; line-height: 1.35; }
  .log-link:hover .log-t { color: var(--accent); }
  .log-rt { font-size: 10px; color: var(--ink-mute); white-space: nowrap; }

  .all-link { margin: 1.25rem 0 0; font-family: var(--font-sans); font-size: 13.5px; }
  .all-link a { color: var(--ink-mute); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--rule); }
  .all-link a:hover { color: var(--accent); text-decoration-color: var(--accent); }

  /* ── Cross-references ──────────────────────────────────────────────── */
  .topic-row { margin: 0; line-height: 2; }
  .topic-link { color: var(--ink); text-decoration: none; margin-inline: 0.1rem; font-family: var(--font-display); font-size: 15px; }
  .topic-link:hover { color: var(--accent); }
  .topic-count { color: var(--ink-mute); font-size: 10px; }
  .topic-dot { color: var(--rule); margin-inline: 0.5rem; }

  @media (max-width: 640px) {
    .unit-head { grid-template-columns: auto 1fr; grid-template-areas: 'n name' 'count count'; }
    .unit-n { grid-area: n; }
    .unit-name { grid-area: name; }
    .unit-count { grid-area: count; }
    .lesson-link { grid-template-columns: 3.2rem 1fr; grid-template-areas: 'ln t' 'lrt lrt'; }
    .lesson-n { grid-area: ln; }
    .lesson-t { grid-area: t; }
    .lesson-rt { grid-area: lrt; }
    .log-link { grid-template-columns: 1fr auto; grid-template-areas: 'date rt' 't t'; row-gap: 0.15rem; }
    .log-date { grid-area: date; }
    .log-rt { grid-area: rt; text-align: right; }
    .log-t { grid-area: t; }
  }
  @media (prefers-reduced-motion: reduce) { .hl-sweep { animation: none; } }
</style>
