---
import BaseLayout from '~/layouts/BaseLayout.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chirag Singhal',
  url: 'https://oriz.in/about/',
  jobTitle: 'Software Engineer',
  description:
    'Software engineer specializing in scalable backend architectures, full-stack development, AI agents, and cloud-native deployments.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bhubaneswar',
    addressRegion: 'Odisha',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://github.com/chirag127',
    'https://x.com/chirag127',
    'https://linkedin.com/in/chirag127',
  ],
}
---

<BaseLayout
  title="About — Blog"
  description="About the oriz blog and Chirag Singhal — software engineer based in Bhubaneswar."
  jsonLd={jsonLd}
  hideSidebar={true}
>
  <header class="page-head">
    <p class="eyebrow"><a href="/">The Margin</a> / About</p>
    <h1>About</h1>
  </header>

  <article class="prose">
    <p class="lede">
      I'm Chirag Singhal — software engineer based in Bhubaneswar, Odisha.
      <strong>The Margin</strong> is my study log: notes on how to learn, kept
      in public so they might be useful to someone else.
    </p>

    <h2>What gets posted here</h2>
    <p>
      How to learn to code without drowning, study methods that actually move
      knowledge into long-term memory, and where the good free learning
      material really is. The common thread: methods I've tested on myself,
      written plainly, and revised when I find out I was wrong.
    </p>

    <h2>Why "The Margin"</h2>
    <p>
      The most useful thing in a textbook is often not what's printed — it's
      what you write in the margin: the question, the objection, the link to
      something you already knew. Learning is that act of annotation. This site
      is a running margin.
    </p>

    <h2>The oriz family</h2>
    <p>
      This is one of the <a href="https://oriz.in">oriz</a> sites — a family of
      static sites that share a sign-in and a single principle:
      <em>useful, free, and quiet</em>. No newsletters you didn't ask for. No
      popups. No paid tier.
    </p>

    <h2>Contact</h2>
    <p>
      Email: <a href="mailto:whyiswhen@gmail.com">whyiswhen@gmail.com</a>.
      Or use the <a href="/contact/">contact form</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .page-head { padding-block: 3rem 1.5rem; border-bottom: 1px solid var(--color-border); max-width: var(--container-prose, 720px); margin-inline: auto; }
  .eyebrow { color: var(--color-fg-muted); font-size: 0.8125rem; margin: 0 0 0.5rem; }
  .eyebrow a { color: var(--color-fg-muted); text-decoration: none; }
  .eyebrow a:hover { color: var(--color-fg); }
  h1 { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .prose { padding-block: 2.5rem 4rem; color: var(--color-prose); line-height: 1.75; font-size: 1.0625rem; max-width: var(--container-prose, 720px); margin-inline: auto; }
  .prose .lede { font-size: 1.1875rem; color: var(--color-fg); margin: 0 0 2rem; }
  .prose h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--color-fg); margin: 2.5rem 0 1rem; }
  .prose p { margin: 0 0 1.25rem; }
  .prose a { color: var(--color-accent); }
</style>
