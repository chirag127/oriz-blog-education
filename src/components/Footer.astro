---
/*
 * Footer — thin institutional COURSE COLOPHON (syllabus archetype).
 *
 * Not the sibling 4-column card footer. One low strip: a course-info line
 * (instructor / license / feed) over a single ruled row of jump links, echoing
 * the syllabus footer of a printed course handout.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { getSeriesWithCounts, slugifyTag } from '~/lib/blog'

const units = (await getSeriesWithCounts()).slice(0, 6)
---
<footer class="course-colophon" role="contentinfo">
  <div class="cc-wrap">
    <p class="cc-line">
      <span class="cc-code">EDU · THE MARGIN</span>
      <span class="cc-dim">a self-taught learning course, kept as working notes by</span>
      <a href="https://oriz.in/about/">Chirag Singhal</a>
    </p>

    <nav class="cc-nav" aria-label="Course units">
      <span class="cc-nav-label">Jump to unit</span>
      {units.map((u, i) => (
        <>
          {i > 0 && <span class="cc-sep" aria-hidden="true">/</span>}
          <a href={`/series/${slugifyTag(u.series)}/`}>{u.series}</a>
        </>
      ))}
    </nav>

    <p class="cc-mantra">The notes in the margin are the ones you keep.</p>
  </div>

  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-education"
    appName="The Margin"
    bio="A self-taught learning course, kept as working notes — study methods, learning to code, and free resources — by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .course-colophon {
    margin-top: 4rem;
    background: var(--paper-2);
    color: var(--ink);
    border-top: 2px solid var(--rule-strong);
  }
  .cc-wrap { max-width: var(--container-page, 1100px); margin: 0 auto; padding: 32px clamp(1rem, 3vw, 1.75rem) 16px; }
  .cc-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .cc-code { color: var(--accent); font-weight: 700; letter-spacing: 0.12em; }
  .cc-dim { color: var(--ink-mute); }
  .cc-line a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--highlighter-wash); }
  .cc-line a:hover { color: var(--accent); }

  .cc-nav {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 13.5px;
  }
  .cc-nav-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-mute);
    margin-right: 0.25rem;
  }
  .cc-nav a { color: var(--ink); text-decoration: none; }
  .cc-nav a:hover { color: var(--accent); }
  .cc-sep { color: var(--rule-strong); }

  .cc-mantra {
    margin: 1.25rem 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(15px, 2vw, 18px);
    color: var(--ink-mute);
  }
</style>
