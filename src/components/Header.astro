---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — thin INSTITUTIONAL COURSE BAR (syllabus archetype).
 *
 *   ┌──────────────────────────────────────────────────────────────────┐
 *   │ EDU · THE MARGIN   a self-taught learning course      ⌘K  ☾  ⋯   │
 *   └──────────────────────────────────────────────────────────────────┘
 *
 * Deliberately NOT the sibling masthead (serif wordmark + centered
 * LATEST/SERIES/TAGS/ABOUT). One low institutional row: a course-code
 * chip + course name on the left, utility (search + controls) on the right.
 * Primary navigation lives in the left-hand syllabus outline, not here.
 */
---

<StatusBanner />
<header class="course-bar" transition:persist="site-header">
  <div class="cb-inner">
    <a class="cb-mark" href="/" aria-label="The Margin — course home">
      <span class="cb-code">EDU</span>
      <span class="cb-name">The&nbsp;Margin</span>
      <span class="cb-sub">a self-taught learning course</span>
    </a>
    <div class="cb-tools">
      <div class="cb-search"><MultiSearch client:idle /></div>
      <HeaderControls client:idle />
    </div>
  </div>
</header>

<style>
  .course-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper-2);
    border-bottom: 1px solid var(--rule-strong);
  }
  .cb-inner {
    height: 46px;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-inline: clamp(0.75rem, 2.5vw, 1.5rem);
  }
  .cb-mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    min-width: 0;
  }
  .cb-code {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-fg);
    background: var(--accent);
    padding: 3px 6px;
    transform: translateY(-1px);
  }
  .cb-name {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
  }
  .cb-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cb-tools {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cb-search { display: inline-flex; align-items: center; }
  @media (max-width: 640px) {
    .cb-sub { display: none; }
  }
</style>
